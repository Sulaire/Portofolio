---
import { idiomas, etiquetasIdioma, inicio, seccion, type Idioma } from '../lib/i18n';

interface Props {
  lang: Idioma;
  t: any;
}
const { lang, t } = Astro.props;

const enlaces = [
  { id: 'servicios', texto: t.nav.servicios },
  { id: 'proyectos', texto: t.nav.proyectos },
  { id: 'sobre-mi', texto: t.nav.sobreMi },
];
---

<header
  id="barra"
  class="fixed inset-x-0 top-0 z-50 border-b border-transparent transition-colors duration-300"
>
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5 sm:px-8">
    <a
      href={inicio(lang)}
      class="text-sm font-semibold tracking-tight text-texto transition-colors hover:text-acento"
    >
      Jordi<span class="text-acento">.</span>
    </a>

    <div class="hidden items-center gap-8 md:flex">
      {
        enlaces.map((e) => (
          <a
            href={seccion(lang, e.id)}
            class="text-sm text-apagado transition-colors hover:text-texto"
          >
            {e.texto}
          </a>
        ))
      }
    </div>

    <div class="flex items-center gap-3">
      <div
        class="flex items-center rounded-full border border-borde bg-superficie/70 p-0.5 backdrop-blur"
      >
        {
          idiomas.map((codigo) => (
            <a
              href={inicio(codigo)}
              hreflang={codigo}
              aria-current={codigo === lang ? 'true' : undefined}
              class:list={[
                'rounded-full px-2.5 py-1 text-xs font-medium transition-colors',
                codigo === lang
                  ? 'bg-acento text-tinta'
                  : 'text-apagado hover:text-texto',
              ]}
            >
              {etiquetasIdioma[codigo]}
            </a>
          ))
        }
      </div>

      <a
        href={seccion(lang, 'contacto')}
        class="hidden rounded-full border border-borde px-4 py-1.5 text-sm font-medium text-texto transition-colors hover:border-acento hover:text-acento sm:inline-block"
      >
        {t.nav.cta}
      </a>

      <button
        id="boton-menu"
        type="button"
        aria-controls="menu-movil"
        aria-expanded="false"
        aria-label={t.nav.servicios}
        class="flex h-8 w-8 items-center justify-center rounded-full border border-borde text-texto transition-colors hover:border-acento md:hidden"
      >
        <svg
          class="h-4 w-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
  </nav>

  <div
    id="menu-movil"
    hidden
    class="border-t border-borde bg-tinta/95 backdrop-blur-md md:hidden"
  >
    <div class="flex flex-col px-5 py-2">
      {
        [...enlaces, { id: 'contacto', texto: t.nav.cta }].map((e) => (
          <a
            href={seccion(lang, e.id)}
            class="border-b border-borde py-3.5 text-sm text-apagado transition-colors last:border-0 hover:text-acento"
          >
            {e.texto}
          </a>
        ))
      }
    </div>
  </div>
</header>

<script>
  // La barra se vuelve opaca en cuanto haces un poco de scroll.
  const barra = document.getElementById('barra');
  const alScrollear = () => {
    if (!barra) return;
    const activa = window.scrollY > 24;
    barra.classList.toggle('bg-tinta/85', activa);
    barra.classList.toggle('backdrop-blur-md', activa);
    barra.classList.toggle('border-borde', activa);
  };
  alScrollear();
  window.addEventListener('scroll', alScrollear, { passive: true });

  // Menú desplegable en móvil.
  const boton = document.getElementById('boton-menu');
  const menu = document.getElementById('menu-movil');
  boton?.addEventListener('click', () => {
    const abierto = boton.getAttribute('aria-expanded') === 'true';
    boton.setAttribute('aria-expanded', String(!abierto));
    if (menu) menu.hidden = abierto;
  });
  // Al pulsar un enlace, se cierra.
  menu?.querySelectorAll('a').forEach((enlace) =>
    enlace.addEventListener('click', () => {
      boton?.setAttribute('aria-expanded', 'false');
      menu.hidden = true;
    }),
  );
</script>
