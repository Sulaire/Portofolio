---
import { Icon } from 'astro-icon/components';
import { seccion, type Idioma } from '../lib/i18n';

interface Props {
  lang: Idioma;
  t: any;
}
const { lang, t } = Astro.props;
---

<section class="relative overflow-hidden px-5 pb-20 pt-28 sm:px-8 sm:pb-28">
  <!-- Halo del color de marca, muy tenue. No es un degradado decorativo:
       solo levanta el fondo detrás del titular. -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -top-56 left-0 h-[30rem] w-[30rem] rounded-full bg-acento/10 blur-[130px]"
  >
  </div>

  <div class="relative mx-auto grid max-w-6xl gap-12 lg:grid-cols-[1.35fr_1fr] lg:items-center lg:gap-16">
    <div>
      <h1 class="text-balance text-4xl leading-[1.08] tracking-tight sm:text-5xl lg:text-6xl">
        {t.hero.titulo}
      </h1>

      <p class="mt-7 max-w-xl text-pretty text-lg leading-relaxed text-apagado">
        {t.hero.subtitulo}
      </p>

      <div class="mt-10 flex flex-wrap items-center gap-3">
        <a
          href={seccion(lang, 'contacto')}
          class="group inline-flex items-center gap-2 rounded-full bg-acento px-6 py-3 text-sm font-semibold text-acento-sobre transition-transform hover:-translate-y-0.5"
        >
          {t.hero.ctaPrimario}
          <Icon
            name="ph:arrow-right"
            class="h-4 w-4 transition-transform group-hover:translate-x-1"
          />
        </a>
        <a
          href={seccion(lang, 'proyectos')}
          class="inline-flex items-center rounded-full border border-borde-fuerte px-6 py-3 text-sm font-medium transition-colors hover:border-acento hover:text-acento"
        >
          {t.hero.ctaSecundario}
        </a>
      </div>
    </div>

    <!-- Ficha: qué hace, con qué y dónde, legible de un vistazo sin
         leer un solo párrafo. -->
    <dl class="rounded-tarjeta border border-borde bg-superficie">
      {
        t.hero.ficha.map((fila: any) => (
          <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 border-b border-borde px-6 py-5 last:border-0">
            <dt class="font-mono text-[11px] uppercase tracking-[0.14em] text-apagado">
              {fila.etiqueta}
            </dt>
            <dd class="text-right text-sm leading-snug">
              {fila.valor}
              {fila.nota && <span class="block text-xs text-apagado">{fila.nota}</span>}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
