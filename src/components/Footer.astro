---
interface Props {
  t: any;
}
const { t } = Astro.props;
const anio = new Date().getFullYear();
---

<footer class="border-t border-borde px-5 py-10 sm:px-8">
  <div
    class="mx-auto flex max-w-6xl flex-col items-start justify-between gap-3 text-xs text-apagado sm:flex-row sm:items-center"
  >
    <p>© {anio} Jordi. {t.footer.derechos}</p>
    <p>{t.footer.hecho}</p>
  </div>
</footer>
