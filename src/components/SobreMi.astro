---
import { pendiente } from '../lib/i18n';

interface Props {
  t: any;
}
const { t } = Astro.props;
---

<section id="sobre-mi" class="border-t border-borde px-5 py-24 sm:px-8">
  <div class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-[1.5fr_1fr] lg:gap-20">
    <div class="aparece">
      <h2 class="text-3xl tracking-tight sm:text-4xl">{t.sobreMi.titulo}</h2>
      <div class="mt-6 space-y-4">
        {
          t.sobreMi.parrafos.map((p: string) => (
            <p
              class:list={[
                'max-w-[62ch] text-pretty leading-relaxed',
                pendiente(p)
                  ? 'rounded-chico border border-dashed border-acento/60 bg-acento-tenue p-4 text-acento'
                  : 'text-apagado',
              ]}
            >
              {p}
            </p>
          ))
        }
      </div>
    </div>

    <div class="aparece space-y-10">
      <div>
        <h3 class="text-sm font-medium">{t.sobreMi.idiomasTitulo}</h3>
        <ul class="mt-4">
          {
            t.sobreMi.idiomas.map((i: any) => (
              <li class="flex items-baseline justify-between gap-4 border-b border-borde py-3 last:border-0">
                <span class="text-sm text-apagado">{i.nombre}</span>
                <span class="font-mono text-xs text-acento">{i.nivel}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-medium">{t.sobreMi.herramientasTitulo}</h3>
        <div class="mt-4 flex flex-wrap gap-2">
          {
            t.sobreMi.herramientas.map((h: string) => (
              <span class="rounded-chico border border-borde bg-superficie px-2.5 py-1 font-mono text-[11px] text-apagado">
                {h}
              </span>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
